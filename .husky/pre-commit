#!/bin/sh
set -e                            # fail early on errors
set -o pipefail                   # catch failures in piped commands

echo "🔍 Running pre-commit checks..."

# ── Collect all staged files ────────────────────────────────────────────────
ALL_STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
echo "📂 All staged files:"
echo "$ALL_STAGED_FILES"

# ── Filter to lintable TS/TSX files only ────────────────────────────────────
LINT_FILES=$(echo "$ALL_STAGED_FILES" | grep -E '\.(ts|tsx)$' || true)
echo "📁 Lintable files:"
echo "$LINT_FILES"

ESLINT_EXIT_CODE=0
TSC_EXIT_CODE=0
CONSOLE_LOG_ERRORS=0

if [ -n "$LINT_FILES" ]; then

  # ── Step 1: ESLint (zero warnings) ─────────────────────────────────────────
  echo ""
  echo "🔧 Step 1/3 — Running ESLint..."
  npx eslint --max-warnings=0 $LINT_FILES || ESLINT_EXIT_CODE=$?
  echo "ESLint exit code: $ESLINT_EXIT_CODE"

  # ── Step 2: console.log check ───────────────────────────────────────────────
  echo ""
  echo "🔎 Step 2/3 — Searching for console.log..."
  CONSOLE_LOG_OUTPUT=$(git grep --cached -n "console\.log" -- $LINT_FILES 2>/dev/null || true)

  if [ -n "$CONSOLE_LOG_OUTPUT" ]; then
    echo "❌ console.log found in staged files:"
    echo "$CONSOLE_LOG_OUTPUT"
    CONSOLE_LOG_ERRORS=1
  else
    echo "✅ No console.log found."
  fi

else
  echo "ℹ️  No TS/TSX files staged — skipping ESLint and console.log checks."
fi

# ── Step 3: TypeScript type-check (always runs — needs full project context) ─
echo ""
echo "🔷 Step 3/3 — Running TypeScript type check..."
npx tsc --noEmit || TSC_EXIT_CODE=$?
echo "TypeScript exit code: $TSC_EXIT_CODE"

if [ $TSC_EXIT_CODE -eq 0 ]; then
  echo "✅ No TypeScript errors."
else
  echo "❌ TypeScript errors found."
fi

# ── Final gate ───────────────────────────────────────────────────────────────
echo ""
if [ $ESLINT_EXIT_CODE -ne 0 ] || [ $CONSOLE_LOG_ERRORS -ne 0 ] || [ $TSC_EXIT_CODE -ne 0 ]; then
  echo "❌ Commit blocked due to errors above."
  echo "   💡 Tip: run 'npm run lint:fix' to auto-fix ESLint issues."
  exit 1
fi

echo "✅ All checks passed — committing."
exit 0
